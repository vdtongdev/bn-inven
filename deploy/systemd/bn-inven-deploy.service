[Unit]
Description=Deploy BN-Inven from GitHub main
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=serveradmin
Group=serveradmin
WorkingDirectory=/srv/apps/bn-inven
ExecStart=/bin/bash /srv/apps/bn-inven/deploy/deploy.sh
TimeoutStartSec=30min
