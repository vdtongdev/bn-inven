# Copy to .env. Keep secrets out of Git.
DATABASE_URL=sqlite:///./data/bn-inven.db
STORAGE_PATH=./data/uploads
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3.5-super-vl:free
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=30000000
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
DOMAIN=inventory.example.com
BASIC_AUTH_USER=bninven
# Generate with: caddy hash-password --plaintext 'replace-with-a-strong-password'
# Wrap the hash in single quotes so Compose does not expand its $ characters.
BASIC_AUTH_HASH=

# Docker deployment on a private Tailscale server (see docs/deployment.md).
# On the server only: set DOMAIN=:80 above (Tailscale Serve terminates HTTPS)
# and uncomment these. Leave them out for local development.
# COMPOSE_PROJECT_NAME=bn-inven
# COMPOSE_FILE=docker-compose.yml:deploy/compose.tailnet.yml
# BN_HTTP_PORT=8090
